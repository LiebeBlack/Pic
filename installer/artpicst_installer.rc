// Icono y versión del instalador de ARTPICST.
// La ruta del icono usa BARRAS NORMALES a propósito: rc.exe (MSVC) y GNU windres
// la resuelven relativa al directorio del .rc y la aceptan igual, mientras que
// las barras invertidas hacen fallar a windres ("cannot open icon file") en
// algunos entornos. Así el .rc compila desde build.bat, build_installer.bat,
// build_mingw.bat o el CI de GitHub Actions sin cambios.

#pragma code_page(1252)

#define IDI_APP_ICON 101

IDI_APP_ICON ICON "../resources/artpicst.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,2,0,0
PRODUCTVERSION 1,2,0,0
FILEFLAGSMASK 0x3FL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName", "ARTPICST"
            VALUE "FileDescription", "ARTPICST Installer"
            VALUE "FileVersion", "1.2.0"
            VALUE "InternalName", "artpicst_installer"
            VALUE "LegalCopyright", "Copyright (C) 2026 ARTPICST"
            VALUE "OriginalFilename", "artpicst_installer.exe"
            VALUE "ProductName", "ARTPICST"
            VALUE "ProductVersion", "1.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
